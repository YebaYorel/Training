{
  "name": "yeba-sites",
  "version": "1.0.0",
  "description": "Sites web YEBA FORMATIONS (animations Framer Motion, design UI/UX Pro Max)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "apercu": "vite build --mode apercu && python3 site/integrer-medias.py",
    "preview": "vite preview",
    "sync": "node site/scripts/airtable-sync.mjs",
    "sync-export": "node site/scripts/airtable-sync.mjs --depuis site/airtable",
    "espace": "vite --config vite.espace.config.js",
    "espace:apercu": "vite build --config vite.espace.config.js --mode apercu",
    "licence": "node site/scripts/licence.mjs",
    "serveur": "node serveur/serveur.mjs",
    "build:studio": "vite build --config vite.espace.config.js --mode studio",
    "build:tout": "npm run build && npm run build:studio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YebaYorel/Training.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/YebaYorel/Training/issues"
  },
  "homepage": "https://github.com/YebaYorel/Training#readme",
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "docx": "^9.7.2",
    "framer-motion": "^13.4.3",
    "jszip": "^3.10.2",
    "lenis": "^1.3.26",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "private": true,
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
