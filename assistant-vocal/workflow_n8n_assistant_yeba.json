    {
      "parameters": {
        "jsCode": "const d = $('Vérifier jeton').item.json;\nconst fmt = s => new Date(s).toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';\nconst debut = d['Date début'] || new Date(Date.now() + 7 * 864e5).toISOString();\nconst fin = d['Date fin'] || new Date(new Date(debut).getTime() + 7 * 36e5).toISOString();\nconst uid = 'yeba-st-' + d.id + '@yeba';\nconst esc = s => String(s || '').replace(/([,;\\\\])/g, '\\\\$1').replace(/\\n/g, '\\\\n');\nconst ics = ['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//YEBA//Assistant//FR','BEGIN:VEVENT',\n  'UID:' + uid, 'DTSTAMP:' + fmt(new Date()), 'DTSTART:' + fmt(debut), 'DTEND:' + fmt(fin),\n  'SUMMARY:' + esc('OPTION sous-traitance – ' + d['Thème'] + ' – ' + d[\"Organisme donneur d'ordre\"]),\n  'LOCATION:' + esc(d['Lieu']), 'STATUS:TENTATIVE',\n  'DESCRIPTION:' + esc('Dates évoquées : ' + d['Dates proposées'] + '\\nContact : ' + d['Interlocuteur'] + ' ' + d['Téléphone'] + ' ' + (d['Email'] || '')),\n  'END:VEVENT','END:VCALENDAR'].join('\\r\\n');\nreturn [{ json: { uid, ics, sans_dates: !d['Date début'] } }];"
      },
