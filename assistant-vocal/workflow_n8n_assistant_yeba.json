      "parameters": {
        "jsCode": "const q = String($('Config').item.json.args.recherche || '').toLowerCase();\nconst rows = ($json.results || []).filter(r => r['Publié']);\nconst pick = rows.filter(r => !q || JSON.stringify(r).toLowerCase().includes(q)).slice(0, 5);\nconst fiche = r => ({\n  intitule: r['Intitulé'], domaine: r['Domaine']?.value, duree_heures: r['Durée (heures)'],\n  modalite: r['Modalité']?.value, prochaine_session: r['Prochaine session'], lieu: r['Lieu'],\n  prix_ht: r['Prix HT (€)'], objectifs: r['Objectifs'], public: r['Public et prérequis'],\n  financements: r['Financements possibles'] });\nreturn [{ json: { ok: true, formations: pick.map(fiche),\n  consigne: pick.length ? 'Résume oralement en 2-3 phrases, propose l\\'envoi du programme par email.'\n                        : 'Aucune formation trouvée : propose un rappel par Aurélien ou le transfert.' } }];"
