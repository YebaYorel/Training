    {
      "parameters": {
        "jsCode": "const c = $('Config').item.json;\nconst sujet = String(c.args.sujet || '').toLowerCase();\nconst docs = {\n  cgv: { titre: 'Conditions générales de vente', url: c.url_cgv,\n    resume: \"Inscription ferme à réception de la convention signée ; conditions d'annulation et de report détaillées dans les CGV.\" },\n  mentions: { titre: 'Mentions légales', url: c.url_mentions,\n    resume: \"YEBA FORMATIONS – SIRET 814 622 262 00032 – déclaration d'activité n° 04973676397 (ne vaut pas agrément de l'État) – certification Qualiopi n° 25FOF02027.1 au titre des actions de formation.\" },\n  confidentialite: { titre: 'Politique de confidentialité', url: c.url_confidentialite,\n    resume: \"Les données de l'appel servent uniquement à traiter votre demande ; vous pouvez demander accès, rectification ou effacement par email.\" },\n};\nconst cle = Object.keys(docs).find(k => sujet.includes(k)) || null;\nreturn [{ json: { ok: true, documents: cle ? [docs[cle]] : Object.values(docs),\n  consigne: \"Ne lis pas les textes juridiques en entier : donne le résumé, propose l'envoi du lien par email ou SMS. Pour toute question juridique précise, transfère à Aurélien.\" } }];"
