{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Edit(./.env)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "ask": [
      "mcp__baserow__delete_row",
      "mcp__baserow__update_row",
      "mcp__playwright__browser_run_code_unsafe",
      "mcp__playwright__browser_file_upload",
      "Bash(rm -rf:*)",
      "mcp__google-ads",
      "mcp__meta-ads",
      "mcp__composio"
    ]
  },
  "enabledMcpjsonServers": [
    "baserow",
    "playwright",
    "chrome-devtools",
    "powerpoint",
    "perplexity",
    "composio"
  ],
  "disabledMcpjsonServers": [
    "google-ads",
    "meta-ads"
  ],
  "enabledPlugins": {
    "context-mode@context-mode": false,
    "cost-guardian@cost-guardian-marketplace": true,
    "video-context@video-context-marketplace": true,
    "linkedin-skills@linkedin-skills": true,
