{
  "enabledPlugins": {
    "context-mode@context-mode": false,
    "cost-guardian@cost-guardian-marketplace": true,
    "video-context@video-context-marketplace": true,
    "linkedin-skills@linkedin-skills": true
  },
  "extraKnownMarketplaces": {
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "cost-guardian-marketplace": {
      "source": {
        "source": "github",
        "repo": "Manavarya09/cost-guardian"
      }
    },
    "video-context-marketplace": {
      "source": {
        "source": "github",
        "repo": "vusallyv/video-context-plugin"
      }
    },
    "linkedin-skills": {
      "source": {
        "source": "github",
        "repo": "sergebulaev/linkedin-skills"
      }
    }
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Edit(./.env)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "ask": [
      "mcp__baserow__delete_row",
      "mcp__baserow__update_row",
      "mcp__playwright__browser_run_code_unsafe",
      "mcp__playwright__browser_file_upload",
      "Bash(rm -rf:*)"
    ]
  },
  "disabledMcpjsonServers": [
    "perplexity",
    "composio"
  ],
  "enabledMcpjsonServers": [
    "baserow",
    "playwright"
  ]
}
