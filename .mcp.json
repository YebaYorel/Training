{
  "mcpServers": {
    "baserow": {
      "command": "python",
      "args": ["baserow_mcp_server.py"],
      "env": {}
    },
    "stitch": {
      "command": "npx",
      "args": ["-y", "@google/stitch-mcp@latest"],
      "env": {
        "STITCH_API_TOKEN": "${STITCH_API_TOKEN}"
      }
    }
  }
}
