{
  "mcpServers": {
    "baserow": {
      "command": "python",
      "args": ["baserow_mcp_server.py"],
      "env": {}
    },
    "playwright": {
      "command": "python",
      "args": ["scripts/playwright_mcp.py"],
      "env": {}
    },
    "perplexity": {
      "type": "http",
      "url": "https://api.perplexity.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${PERPLEXITY_API_KEY:-}"
      }
    },
    "composio": {
      "type": "http",
      "url": "https://connect.composio.dev/mcp"
    }
  }
}
