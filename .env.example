# =============================================================================
#  Configuration de la connexion Baserow  <->  Claude Code
#  YEBA FORMATIONS  —  copiez ce fichier en « .env » et remplissez les valeurs.
#  Le fichier .env est ignoré par Git : vos secrets NE quittent JAMAIS le dépôt.
# =============================================================================

# --- Instance Baserow -------------------------------------------------------
# Cloud UE (par défaut). Ne pas mettre de « / » final.
BASEROW_API_URL=https://api.baserow.io

# --- Authentification STRUCTURE (JWT) ---------------------------------------
# Compte de service DÉDIÉ (jamais votre compte personnel), rôle « Builder ».
# Nécessaire pour CRÉER bases / tables / champs.
BASEROW_EMAIL=service-claude@votre-domaine.re
BASEROW_PASSWORD=change-me

# --- Authentification DONNÉES (Database Token) ------------------------------
# Jeton créé dans Baserow (Paramètres > jetons de base de données).
# Suffit pour lire/écrire des LIGNES. Laisser vide pour tout faire en JWT.
BASEROW_TOKEN=

# --- Optionnel : workspace par défaut ---------------------------------------
# ID du workspace (groupe) dans lequel créer les bases. Vide = on vous demande.
BASEROW_WORKSPACE_ID=

# --- Migration Airtable → Baserow (lecture seule côté Airtable) -------------
# Jeton personnel Airtable : scopes data.records:read + schema.bases:read,
# accès limité à LA base à migrer. À RÉVOQUER une fois la migration validée.
AIRTABLE_PAT=
AIRTABLE_BASE_ID=appGyK0pp3tlRABVA
